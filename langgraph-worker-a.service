[Unit]
Description=Gryps LangGraph Implementation Worker A
After=network-online.target langgraph-control.service

[Service]
Type=simple
WorkingDirectory=%h/apps/langgraph-worker-a
EnvironmentFile=-%h/apps/langgraph-worker-a/.env
ExecStart=%h/apps/langgraph-worker-a/run.sh
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
