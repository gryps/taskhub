TASKHUB_VERSION=0.1.0-alpha
TASKHUB_PORT=8200
TASKHUB_SEED_IMAGE=taskhub-seed:0.1.0-alpha
TASKHUB_NODE_IMAGE=taskhub-node:0.1.0-alpha
TASKHUB_POSTGRES_IMAGE=postgres:16-alpine
TASKHUB_DOCKER_PROXY_IMAGE=ghcr.io/tecnativa/docker-socket-proxy:v0.5.0
TASKHUB_DATA_VOLUME=taskhub-data
TASKHUB_POSTGRES_VOLUME=taskhub-postgres-data
TASKHUB_COOKIE_SECURE=true
TASKHUB_ENFORCE_HTTPS=true
TASKHUB_TLS_DIRECTORY=./tls
TASKHUB_TLS_CERT_FILE=/run/taskhub/tls/taskhub.crt
TASKHUB_TLS_KEY_FILE=/run/taskhub/tls/taskhub.key
TASKHUB_TRUSTED_HOSTS=*
TASKHUB_SESSION_IDLE_SECONDS=1800
TASKHUB_SESSION_ABSOLUTE_SECONDS=43200
TASKHUB_LOGIN_MAX_FAILURES=5
TASKHUB_LOGIN_WINDOW_SECONDS=900
TASKHUB_LOGIN_LOCK_SECONDS=900
TASKHUB_OPENAI_PROXY_URL=
TASKHUB_POSTGRES_PASSWORD=replace-with-random-hex
TASKHUB_ADMIN_TOKEN=replace-with-random-admin-token
TASKHUB_SESSION_SECRET=replace-with-random-session-secret
TASKHUB_CONFIG_ENCRYPTION_KEY=replace-with-fernet-key
