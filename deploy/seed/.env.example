# Copy to .env or run start-seed.ps1 to generate secure local values.
TASKHUB_PORT=8200
# Address used to publish short-lived browser-acceptance previews.
TASKHUB_PREVIEW_BIND_ADDRESS=0.0.0.0
TASKHUB_PRODUCTION_ORCHESTRATION_ENABLED=false
# Optional, for example: http://proxy-host:port
TASKHUB_BUILD_PROXY=
TASKHUB_POSTGRES_PASSWORD=replace-with-random-hex
TASKHUB_ADMIN_TOKEN=replace-with-random-admin-token
TASKHUB_SESSION_SECRET=replace-with-random-session-secret
TASKHUB_CONFIG_ENCRYPTION_KEY=replace-with-fernet-key
TASKHUB_NODE_TOKEN=replace-with-random-node-token
